# Copy to .env, fill in, then: chmod 600 .env && docker compose up -d
# Required
TOKEN=123456:replace-with-your-bot-token
MANAGER=123456789
WEB_PASSWORD=replace-with-16-or-more-random-characters
# The address you open in the browser (https://… behind a reverse proxy)
WEB_ORIGIN=http://127.0.0.1:8730
# Optional: pin the image version for production
# RSSTT_WEB_IMAGE=ghcr.io/jaaayden/rsstt-web:1.0.0
# Optional upstream settings (all of them work here), for example:
# API_ID=
# API_HASH=
# TELEGRAPH_TOKEN=token1 token2 token3
# MULTIUSER=0
# T_PROXY=socks5://127.0.0.1:1080
